# SwiftPM
/.build/
.swiftpm/
Package.resolved

# Assembled app bundle (produced by ./bundle.sh)
/build/

# Local, personalized timelines (run `PERSONALIZE=1 python3 tools/generate_strobe.py`
# to bake in your own system stats / desktop images — keep those out of git)
/examples/*.local.json

# Keep the large raw master out of git; the compressed mp3 IS committed (licensed).
song.wav
assets/*.wav
# …but the gate's two sounds are required runtime assets, not masters: 72 KB and 132 KB,
# named by the intro gate and copied into the .app by bundle.sh. Without these exceptions
# a fresh clone builds an app whose gate is silent. `bubble` is the alert arriving,
# `click` is it being answered.
!assets/bubble_sound.wav
!assets/click_sound.wav

# Sarah's source material: 156 MB of screen recordings, layered PSDs and full-size
# originals. The pieces the show actually loads are committed as derived copies under
# assets/ (pixelface.jpg, lyrics_desktops/), so the masters stay out.
assets/sarah's assets/

# The broken-screen drop: 22 photographs and screen grabs, 18 MB, of which the cut uses
# eight. Same arrangement as sarah's assets — the drop stays out, and what the show loads
# is a downsized derived copy under assets/broken_screens/ (built by generate_show.py's
# build_broken_screens), which IS committed.
assets/broken_computer/

# Reference images nothing in the piece loads. Named individually rather than by a
# pattern: a blanket assets/*.png would have swallowed credits_tile.png and app_icon.png,
# and a blanket rule is exactly how bubble_sound.wav ended up silently untracked.
assets/museum-patron-Dance-I-Henri-Matisse-1909.webp
assets/museum-patron-Dance-I-Henri-Matisse-1909 copy.png
assets/*.aif
assets/*.aiff
*.mov
*.mp4
# ...except the clip cue 27's segmenter swarm takes the screen with: 44 MB, the one
# video the show loads, LFS-tracked like the mp3 (see .gitattributes). Without this
# exception a fresh clone's segSwarm cue opens on nothing.
!assets/giveit2meclip.mp4

# Python (tools/)
__pycache__/

# macOS
.DS_Store

# Xcode (if you generate a project)
*.xcodeproj
*.xcworkspace
xcuserdata/

# The wasm DooM engine (tools/fetch_doom.sh) — fetched, not committed: it is a GPL
# build with the shareware IWAD baked in. See the script header.
assets/doom.wasm
